# Compiled binary
/wraptool
# Cross-compiled release/test binaries (mirrors CI's dist/ layout). Untracked
# output here otherwise dirties the tree, which -buildvcs then stamps into
# every subsequent binary as vcs.modified=true.
/dist/

# Wraptool runtime data
/requests.jsonl
# Personal Claude Code state stays local; shared agent definitions are tracked.
.claude/*
!.claude/agents/

# Quarto build output
/docs/_site/
/docs/.quarto/
/public/
.gemini/
.mcp.json
.devcontainer/devcontainer-lock.json
.agents
.mcp.json*
opencode.json
skills-lock.json

/.quarto/
**/*.quarto_ipynb
