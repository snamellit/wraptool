{
    "name": "wraptool-dev",

    // A Go-capable client box for coding on wraptool from inside a container.
    // NOTE: this repo's own build env is Guix (.envrc → `use guix`); this dev
    // container is a client dogfood of the wiring-only wraptool feature + `wraptool
    // up`, not a replacement for the Guix flow. Credentials stay on the host and
    // are reached through the wrapped MCP tools.
    "image": "mcr.microsoft.com/devcontainers/go:1-bookworm",

    "features": {
        // For the `devcontainer` CLI itself (features/ test + publish) and any
        // other npm tooling in this repo — NOT for the harness, which arrives
        // pinned in the harness-pool runtime/ mount below.
        "ghcr.io/devcontainers/features/node:1": {},

        // Wire Claude Code to host wraptool. Wiring only (§12.3, :1 major): the
        // binary is NOT installed here — it comes from the host harness-pool
        // runtime/ mount below (`wraptool harness install claude` on the host).
        "forge.snamellit.com/pti/wraptool/wraptool:1": {
            "harness": "claude"
        }
    },

    // WRAPTOOL_CWD (non-secret host workspace path) is fine baked into the image.
    "containerEnv": {
	"WRAPTOOL_CWD": "${localWorkspaceFolder}"
    },
    // The token is a secret: use remoteEnv so it is applied at runtime and to
    // lifecycle hooks (postCreate) rather than baked into an image layer.
    // Inherited from the host env — `wraptool up` sets it, or export it manually.
    "remoteEnv": {
        "WRAPTOOL_TOKEN": "${localEnv:WRAPTOOL_TOKEN}"
    },

    // Shared developer toolbox (design/harness/unified-harness-pool.md §12.3):
    // home/ (auth/skills/config) is read-write so it persists across every
    // project; runtime/ (the version-locked harness binaries) is read-only — a
    // cross-project trust domain this container must never write. The runtime
    // entry MUST stay the string form: the devcontainer CLI's object-form
    // mounts have no read-only field at all and silently come up read-write
    // regardless of any "readonly" key.
    "mounts": [
        {
            "source": "${localEnv:HOME}/.local/share/wraptool/harness-pool/home",
            "target": "/home/wraptool-harness",
            "type": "bind"
        },
        "source=${localEnv:HOME}/.local/share/wraptool/harness-pool/runtime,target=/opt/wraptool-harness/runtime,type=bind,readonly"
    ]
}
