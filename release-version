#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./release-version [--dry-run] [--yes] VERSION|patch|minor|major

Create and push a wraptool release tag from a clean, synchronized main branch.
VERSION must be an unprefixed stable SemVer such as 1.2.3.

  --dry-run  calculate and test the release without creating a tag
  --yes      skip the interactive confirmation
EOF
}

dry_run=false
assume_yes=false
requested=""

for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --yes) assume_yes=true ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown option: $arg" >&2; usage >&2; exit 2 ;;
    *)
      if [[ -n "$requested" ]]; then
        echo "only one version or bump level may be specified" >&2
        usage >&2
        exit 2
      fi
      requested=$arg
      ;;
  esac
done

if [[ -z "$requested" ]]; then
  usage >&2
  exit 2
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "release-version must run inside the wraptool repository" >&2
  exit 1
}
cd "$root"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "working tree is not clean; commit or stash changes before releasing" >&2
  exit 1
fi
if [[ "$(git branch --show-current)" != main ]]; then
  echo "releases must be created from the main branch" >&2
  exit 1
fi

echo "Fetching origin and release tags..."
git fetch --prune --tags origin

if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
  echo "local main must exactly match origin/main before releasing" >&2
  exit 1
fi

semver_re='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
latest=""
while IFS= read -r tag; do
  candidate=${tag#wraptool-v}
  if [[ "$candidate" =~ $semver_re ]]; then
    latest=$candidate
    break
  fi
done < <(git tag --list 'wraptool-v*' --sort=-version:refname)

if [[ -z "$latest" ]]; then
  latest=0.0.0
fi

IFS=. read -r latest_major latest_minor latest_patch <<<"$latest"
case "$requested" in
  patch) version="$latest_major.$latest_minor.$((10#$latest_patch + 1))" ;;
  minor) version="$latest_major.$((10#$latest_minor + 1)).0" ;;
  major) version="$((10#$latest_major + 1)).0.0" ;;
  *)
    if [[ ! "$requested" =~ $semver_re ]]; then
      echo "invalid version '$requested'; expected MAJOR.MINOR.PATCH" >&2
      exit 2
    fi
    version=$requested
    ;;
esac

version_gt() {
  local left=$1 right=$2
  local -a left_parts right_parts
  local i
  IFS=. read -r -a left_parts <<<"$left"
  IFS=. read -r -a right_parts <<<"$right"
  for i in 0 1 2; do
    if ((${#left_parts[i]} > ${#right_parts[i]})); then return 0; fi
    if ((${#left_parts[i]} < ${#right_parts[i]})); then return 1; fi
    if [[ "${left_parts[i]}" > "${right_parts[i]}" ]]; then return 0; fi
    if [[ "${left_parts[i]}" < "${right_parts[i]}" ]]; then return 1; fi
  done
  return 1
}

if ! version_gt "$version" "$latest"; then
  echo "release version $version must be greater than latest release $latest" >&2
  exit 1
fi

tag="wraptool-v$version"
if git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
  echo "tag $tag already exists" >&2
  exit 1
fi

echo "Latest release: $latest"
echo "New release:    $version"
echo "Commit:         $(git rev-parse HEAD)"

if [[ "$dry_run" == false && "$assume_yes" == false ]]; then
  if [[ ! -t 0 ]]; then
    echo "non-interactive release requires --yes" >&2
    exit 1
  fi
  read -r -p "Create and push $tag? [y/N] " answer
  if [[ "$answer" != y && "$answer" != Y ]]; then
    echo "release cancelled"
    exit 1
  fi
fi

echo "Running release tests..."
GOTOOLCHAIN=local go test ./...

if [[ "$dry_run" == true ]]; then
  echo "Dry run complete; no tag was created."
  exit 0
fi

git tag -a "$tag" -m "wraptool $version"
if ! git push origin "$tag"; then
  git tag -d "$tag" >/dev/null
  echo "tag push failed; removed local $tag so the release can be retried" >&2
  exit 1
fi

echo "Released $tag"
